# Backend Configuration
# The Python backend (trainning-notebooks/final-chatbot-server.ipynb) is run on Kaggle
# and exposes itself through a Cloudflare Quick Tunnel (https://*.trycloudflare.com).
# Paste the public URL printed by the startup cell here. An ngrok URL works too.
NEXT_PUBLIC_BACKEND_URL=https://your-tunnel-url.trycloudflare.com

# MongoDB Configuration (if using authentication)
MONGODB_URI=your_mongodb_connection_string_here

# Session Secret (for authentication)
SESSION_SECRET=your_random_secret_key_here
